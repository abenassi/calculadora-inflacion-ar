{
  "name": "calculadora-inflacion-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Calculadora de inflación argentina con datos vía Argentina Data MCP",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/generar-paginas.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "tsx scripts/fetch-snapshot.ts",
    "verificar": "tsc --noEmit && vitest run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "chart.js": "^4.4.7"
  }
}
